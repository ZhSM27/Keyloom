include LICENSE README.md README.en.md THIRD_PARTY_NOTICES.md CONTRIBUTING.md SECURITY.md CHANGELOG.md AGENTS.md studio.bat .gitignore .gitattributes
recursive-include docs *.md
recursive-include tests *.py
recursive-include scripts *.py
recursive-include .github *.yml
recursive-include keyloom_mania/generation_studio_web *.html *.css *.js
recursive-include keyloom_mania/resources *.json
recursive-include keyloom_mania/_vendor LICENSE* *.json
global-exclude __pycache__ *.py[cod] *.pt *.pth *.ckpt *.log .env
